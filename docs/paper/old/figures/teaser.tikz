% Before/after deployment teaser, redrawn as a vector diagram.
% Left  : stock YOLO11n requested on DLA -> heterogeneous DLA+GPU fallback engine.
% Right : YOLO11-DLA -> complete learned graph in one DLA loadable, host tail outside.
% Base palette (archInk/archTeal/archMint/archGray/archGold) from architecture_styles.tex.
\providecolor{archGrayEdge}{HTML}{9BA6B2}
\providecolor{archBoxGray}{HTML}{DADEE1}
\providecolor{archCellGray}{HTML}{EDEFF2}
\providecolor{nodeDla}{HTML}{C2DAD7}
\providecolor{nodeGpu}{HTML}{CBD3DA}
\providecolor{nodeGpuEdge}{HTML}{8F99A4}
\providecolor{nodeRfm}{HTML}{E7EAEE}
\providecolor{nodeRfmEdge}{HTML}{A8B0B8}
\providecolor{nodeNop}{HTML}{F5F6F8}
\providecolor{nodeNopEdge}{HTML}{C3C9CF}
\providecolor{archRose}{HTML}{F9DDDE}
\providecolor{archRoseEdge}{HTML}{BE5F5C}
\providecolor{slabGrayFront}{HTML}{CDD2D6}
\providecolor{slabGrayTop}{HTML}{E6E9EC}
\providecolor{slabGraySide}{HTML}{B7BDC3}
\providecolor{slabTealFront}{HTML}{C6E3DE}
\providecolor{slabTealTop}{HTML}{E4F3F0}
\providecolor{slabTealSide}{HTML}{A6CEC7}

% One convolutional slab drawn as a flat parallelepiped: #1=x #2=y(bottom)
% #3=width #4=height #5=colour base (slabGray / slabTeal).
\newcommand{\convslab}[5]{%
  \fill[#5Side,draw=archInk!60,line width=.4pt]
    ({#1+#3},{#2}) -- ++(.18,.15) -- ++(0,#4) -- ++(-.18,-.15) -- cycle;
  \fill[#5Top,draw=archInk!60,line width=.4pt]
    ({#1},{#2+#4}) -- ++(.18,.15) -- ++(#3,0) -- ++(-.18,-.15) -- cycle;
  \fill[#5Front,draw=archInk!60,line width=.4pt]
    ({#1},{#2}) rectangle ++(#3,#4);}

\begin{tikzpicture}[x=1cm,y=1cm,
  ttl/.style={font=\rmfamily\bfseries\fontsize{16}{18}\selectfont,text=archInk,
              anchor=north,inner sep=0pt},
  mdl/.style={rounded corners=4pt,line width=.7pt,align=center,anchor=north,
              font=\rmfamily\bfseries\fontsize{14}{16}\selectfont,text=archInk,
              minimum width=4.0cm,minimum height=1.10cm},
  sub/.style={font=\rmfamily\fontsize{11}{13}\selectfont,text=archInk,
              anchor=north,inner sep=0pt},
  io/.style={font=\rmfamily\fontsize{11}{13}\selectfont,text=archInk,inner sep=0pt},
  dots/.style={font=\rmfamily\fontsize{12}{12}\selectfont,text=archInk,inner sep=0pt},
  pill/.style={rounded corners=3pt,line width=.6pt,align=center,
               font=\rmfamily\bfseries\fontsize{10.5}{12}\selectfont,text=archInk,
               inner xsep=5pt,inner ysep=3.5pt},
  cell/.style={rounded corners=.7pt,line width=.35pt,anchor=west,
               minimum width=.128cm,minimum height=.44cm,inner sep=0pt},
  cD/.style={cell,draw=archTeal!65,fill=nodeDla,minimum height=.62cm,line width=.45pt},
  cG/.style={cell,draw=nodeGpuEdge,fill=nodeGpu},
  cR/.style={cell,draw=nodeRfmEdge,fill=nodeRfm},
  cN/.style={cell,draw=nodeNopEdge,fill=nodeNop},
  cC/.style={cell,draw=nodeNopEdge,fill=nodeNop},
  swat/.style={rounded corners=.7pt,line width=.35pt,anchor=west,
               minimum width=.30cm,minimum height=.24cm,inner sep=0pt},
  leg/.style={font=\rmfamily\fontsize{9}{10.5}\selectfont,text=archInk,
              anchor=west,inner sep=0pt},
  tot/.style={font=\rmfamily\fontsize{9.5}{11}\selectfont,text=archInk,
              anchor=north,inner sep=0pt},
  big/.style={rounded corners=3.5pt,line width=.9pt,align=center,anchor=west,
              minimum height=1.40cm,text=archInk},
  flow/.style={-{Latex[length=2mm,width=1.6mm]},draw=archInk,line width=.7pt},
  tick/.style={-{Latex[length=1.0mm,width=1.0mm]},draw=archInk,line width=.5pt},
  cue/.style={-{Latex[length=1.8mm,width=1.4mm]},draw=archInk!70,line width=.55pt,
              dash pattern=on 1.6pt off 1.4pt},
  cueT/.style={cue,draw=archTeal},
  brc/.style={decorate,decoration={brace,mirror,amplitude=5pt,raise=1.5pt},
              draw=archInk!75,line width=.55pt},
  blab/.style={font=\rmfamily\fontsize{10.5}{12}\selectfont,text=archInk,
               anchor=north,inner sep=0pt},
]

% ############################ BEFORE ############################
\node[mdl,draw=archGrayEdge,fill=archBoxGray] at (4.15,-1.40) {Stock YOLO11n};
\node[sub] at (4.15,-2.70) {DLA+GPU fallback deployment};

% --- CNN schematic ---
\node[io] at (1.00,-4.25) {Input};
\draw[flow] (1.58,-4.25) -- (2.08,-4.25);
\foreach \sx in {2.25,2.75,3.25}{\convslab{\sx}{-4.90}{.28}{1.30}{slabGray}}
\node[dots] at (4.05,-4.20) {$\cdots$};
\foreach \sx in {4.40,4.90,5.40}{\convslab{\sx}{-4.90}{.28}{1.30}{slabGray}}
\draw[flow] (6.06,-4.25) -- (6.56,-4.25);
\node[io] at (7.16,-4.25) {Output};

% --- descent into the compiled engine ---

