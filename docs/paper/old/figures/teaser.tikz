% ############################ AFTER ############################
\node[mdl,draw=archTeal,fill=archMint,line width=.9pt] at (12.65,-1.40) {YOLO11-DLA};
\node[sub] at (12.65,-2.70) {Strict DLA placement};

% --- CNN schematic ---
\node[io] at (9.50,-4.25) {Input};
\draw[flow] (10.08,-4.25) -- (10.58,-4.25);
\foreach \sx in {10.75,11.25,11.75}{\convslab{\sx}{-4.90}{.28}{1.30}{slabTeal}}
\node[dots] at (12.55,-4.20) {$\cdots$};
\foreach \sx in {12.90,13.40,13.90}{\convslab{\sx}{-4.90}{.28}{1.30}{slabTeal}}
\draw[flow] (14.56,-4.25) -- (15.06,-4.25);
\node[io] at (15.66,-4.25) {Output};

% --- descent into the compiled engine ---
\draw[flow] (12.55,-5.05) -- (12.55,-5.80);

% --- one loadable ---
\draw[tick] (9.30,-6.50) -- (9.60,-6.50);
\node[big,draw=archTeal,fill=archMint,minimum width=6.15cm] (dlabox) at (9.60,-6.50)
  {{\rmfamily\bfseries\fontsize{13}{15}\selectfont DLA}\\[1pt]
   {\rmfamily\fontsize{10}{11}\selectfont (single learned graph)}};
\draw[tick] (15.75,-6.50) -- (16.05,-6.50);

% --- measured composition of the optimized strict engine ---
\draw[brc] (9.60,-7.32) -- (15.75,-7.32);
\node[blab] at (12.675,-7.57) {1 DLA loadable};
\node[tot] at (12.675,-7.96) {1 node in the optimized engine};
